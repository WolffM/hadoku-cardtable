{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Bundler resolution, not nodenext: this package is served by Vite, never
    // by Node. It is also what lets `import fixture from './x.json'` work
    // without an import attribute, which is how the committed fixtures load.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "vite.embed.config.ts", "build-defines.ts"]
}
