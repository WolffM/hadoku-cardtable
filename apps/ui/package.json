{
  "name": "@hadoku/ui",
  "version": "0.32.715",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "Draft UI — the interior of the room's central canvas slot. Three sources: fixtures, the in-process engine, and a live socket. Card art resolves through @hadoku/carddata/art (Scryfall's image CDN by default); no image bytes are bundled.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.embed.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:css": "node node_modules/@wolffm/themes/scripts/check-usage.mjs ./src"
  },
  "dependencies": {
    "@hadoku/carddata": "workspace:*",
    "@hadoku/deck": "workspace:*",
    "@hadoku/forge-wire": "workspace:*",
    "@hadoku/shared": "workspace:*",
    "@wolffm/game-stats-ui": "npm:@hadoku/game-stats-ui@0.1.8",
    "@wolffm/prefs-client": "npm:@hadoku/prefs-client@1.1.5",
    "@wolffm/rooms-protocol": "npm:@hadoku/rooms-protocol@0.44.11",
    "@wolffm/task-ui-components": "npm:@hadoku/task-ui-components@4.22.1",
    "@wolffm/themes": "npm:@hadoku/themes@5.13.6",
    "@wolffm/watchparty-ui": "npm:@hadoku/watchparty-ui@0.44.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io-client": "^4.8.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@wolffm/catalogue": "npm:@hadoku/catalogue@^1.0.11",
    "vite": "8.2.2"
  }
}
