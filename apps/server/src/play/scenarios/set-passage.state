# chosen-sets.jvm.test.ts: seat 0 at its own Main Phase 1 with Guided Passage ("reveal the cards in your
# library. An opponent chooses from among them a creature card, a land card, and a noncreature, nonland
# card"). The library holds Dryad Arbor (a creature and a land), a Forest, Grizzly Bears, Lightning Bolt and
# an Island, so three different cards can fill the three kinds and Dryad Arbor may not stand for two.
turn=1
activeplayer=human
activephase=MAIN1
humanlife=20
ailife=20
humanhand=Guided Passage
humanbattlefield=Forest;Island;Mountain
humanlibrary=Dryad Arbor;Forest;Grizzly Bears;Lightning Bolt;Island
humangraveyard=
aihand=Island
aibattlefield=Island
ailibrary=Island;Island;Island;Island;Island;Island
aigraveyard=
