# Fact or Fiction's own chooseCardsPile ask (PlayerControllerHuman.java:2576):
# the caster reveals the top 5 of THEIR OWN library, the opponent separates
# those 5 into two piles, and the caster (Fact or Fiction leaves Chooser at
# its default, the caster) picks one. Both seats hold the spell and four
# Islands, so either can be the caster (the test swaps `activeplayer`); both
# libraries' top five are the same five known cards.
turn=1
activeplayer=human
activephase=MAIN1
humanlife=20
ailife=20
humanhand=Fact or Fiction
humanbattlefield=Island;Island;Island;Island
humanlibrary=Llanowar Elves;Lightning Bolt;Brainstorm;Opt;Ponder;Island;Island;Island;Island;Island
humangraveyard=
aihand=Fact or Fiction
aibattlefield=Island;Island;Island;Island
ailibrary=Llanowar Elves;Lightning Bolt;Brainstorm;Opt;Ponder;Island;Island;Island;Island;Island
