# e2e/ei-end-turn-interrupt.spec.ts — an opponent's spell interrupts End Turn.
# Alice (seat 0) is in her own Main 1 holding Counterspell over two untapped Islands, and presses
# End Turn. Bob (seat 1) holds Lightning Bolt over an untapped Mountain, so alice's End step is a
# play for him (his End step stop holds it) and he bolts her there. Alice must get priority over
# the Bolt, with her Counterspell offered.
turn=1
activeplayer=human
activephase=MAIN1
humanlife=20
ailife=20
humanhand=Counterspell
humanbattlefield=Island;Island
humanlibrary=Island;Island;Island;Island;Island;Island
humangraveyard=
aihand=Lightning Bolt
aibattlefield=Mountain
ailibrary=Mountain;Mountain;Mountain;Mountain;Mountain;Mountain
aigraveyard=
