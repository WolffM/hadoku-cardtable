{
  "name": "@hadoku/server",
  "version": "0.32.490",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "Loopback tunnel server — serves the built @hadoku/ui SPA and the room/draft socket at hadoku.me/cardtable/, friend tier.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js --external:express --external:socket.io --external:@wolffm/rooms-protocol --external:@wolffm/rooms-server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hadoku/carddata": "workspace:*",
    "@hadoku/deck": "workspace:*",
    "@hadoku/draft": "workspace:*",
    "@hadoku/forge-wire": "workspace:*",
    "@hadoku/room-store": "workspace:*",
    "@hadoku/shared": "workspace:*",
    "@wolffm/prefs-client": "npm:@hadoku/prefs-client@1.1.5",
    "@wolffm/rooms-protocol": "npm:@hadoku/rooms-protocol@0.44.4",
    "@wolffm/rooms-server": "npm:@hadoku/rooms-server@0.44.4",
    "express": "^5.1.0",
    "socket.io": "^4.8.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "esbuild": "0.28.2",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2"
  }
}
