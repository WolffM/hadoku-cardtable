{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // nodenext (inherited): this package IS run by Node. Relative imports carry `.js`; Magic's
    // files are imported through `@hadoku/magic-server/<path>` (its `./*` export).
    //
    // `noEmit` because esbuild, not tsc, builds `dist/` (`package.json`'s `build`, and
    // `src/index.ts`'s header): the workspace packages export TypeScript SOURCE with `.ts`
    // imports, which needs `allowImportingTsExtensions`, which is only legal with `noEmit`.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "sourceMap": false,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  // Tests are included so they are typechecked; esbuild bundles from `src/index.ts` and Magic's
  // catalog worker alone, so nothing a test defines reaches `dist/`.
  "include": ["src/**/*.ts"]
}
