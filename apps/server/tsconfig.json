{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // nodenext (inherited): this package IS run by Node, unlike apps/ui which
    // Vite serves. That is why the relative imports here carry a `.js`
    // extension — nodenext ESM requires it, and tsc does not add it.
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "lib": ["ES2023"]
  },
  "include": ["src/**/*.ts"]
}
