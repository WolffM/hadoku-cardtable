{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // esbuild bundles (scripts/agent/deploy.sh); tsc only typechecks. The wire is
    // imported from the server's source by its `.ts` path, as the server's own
    // workspace packages are.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "sourceMap": false,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
