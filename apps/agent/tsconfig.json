{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // esbuild bundles (scripts/agent/deploy.sh); tsc only typechecks. The wire is
    // @hadoku/host-wire, a workspace package of `.ts` source.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "sourceMap": false,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
