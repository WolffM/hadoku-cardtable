{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Run by Node (it strips TypeScript natively), never built: relative imports carry an
    // explicit `.ts` extension. No DOM: these are command-line tools.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
