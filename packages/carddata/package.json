{
  "name": "@hadoku/carddata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "Scryfall bulk-data ingest, Forge .dck/.draft parsing, cube card resolution, and the card-art manifest — resolved for the browser and uploaded to cdn.hadoku.me by the upload-art CLI.",
  "exports": {
    ".": "./src/index.ts",
    "./art": "./src/art/index.ts"
  },
  "scripts": {
    "sync": "node src/cli/sync-cards.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "resolve": "node --max-old-space-size=6144 src/cli/resolve-cubes.ts",
    "gen:set-codes": "node src/cli/gen-set-codes.ts",
    "build-pool": "node --max-old-space-size=6144 src/cli/build-pool.ts",
    "upload-art": "node src/cli/upload-art.ts"
  },
  "dependencies": {
    "@wolffm/cdn-client": "1.0.5"
  },
  "devDependencies": {}
}
