{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Served by Vite inside the app, never run by Node on its own: bundler
    // resolution and the DOM, as apps/ui has. No build step; the `.ts` files
    // in src/ are what consumers import.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
