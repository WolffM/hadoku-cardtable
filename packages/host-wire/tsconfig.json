{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Imported by the server (Node strips TypeScript natively) and bundled into the agent by
    // esbuild, never built on its own: the `.ts` files in src/ are what consumers import.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
