{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Run by Node (it strips TypeScript natively) inside the app's server: the
    // `.ts` files in src/ are what workspace consumers import, so relative
    // imports carry an explicit `.ts` extension. The published dist/ is built
    // from this config by scripts/publish/build.ts. No DOM: server code.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
