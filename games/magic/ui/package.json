{
  "name": "@hadoku/magic-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "Magic's browser half: the draft, deck and constructed screens, the live board and its prompts, replays, the room list and front-page pieces that know Magic, stats, sounds and the vendored mana and set symbols. Card art resolves through @hadoku/carddata/art; no image bytes are bundled. No build step: the site (apps/ui, @hadoku/ui) composes it and vite builds the SPA there.",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hadoku/carddata": "workspace:*",
    "@hadoku/deck": "workspace:*",
    "@hadoku/forge-wire": "workspace:*",
    "@hadoku/game-ui": "workspace:*",
    "@hadoku/shared": "workspace:*",
    "@hadoku/ui-shell": "workspace:*",
    "@wolffm/game-stats-ui": "npm:@hadoku/game-stats-ui@0.1.12",
    "@wolffm/prefs-client": "npm:@hadoku/prefs-client@1.1.27",
    "@wolffm/rooms-client": "npm:@hadoku/rooms-client@0.45.91",
    "@wolffm/rooms-protocol": "npm:@hadoku/rooms-protocol@0.45.91",
    "@wolffm/themes": "npm:@hadoku/themes@5.14.4",
    "@wolffm/watchparty-ui": "npm:@hadoku/watchparty-ui@0.45.91",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io-client": "^4.8.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@hadoku/game-server": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "vite": "8.2.2"
  }
}
