humanlibrary=Mountain;Mountain;Mountain;Mountain
humangraveyard=
aihand=
aibattlefield=Mountain;Swamp;Forest|Tapped;Island;Plains;Serra Angel;Owlin Shieldmage;Waterfall Aerialist;Gladecover Scout;Kalonian Behemoth;Rimeshield Frost Giant;Elspeth, Sun's Champion|Counters:LOYALTY=6;T:r_1_1_goblin;T:w_1_1_soldier;T:g_1_1_elf_warrior
ailibrary=Mountain;Mountain;Mountain;Mountain
