# "Testing: Board — Big board" (room/testing-rooms.ts): 15 permanents a side
# — five lands, seven real creatures (or a planeswalker on the AI's side) and
# three tokens each — to stress the battlefield's row-fit and layout at a
# size no ordinary game reaches this early. Tokens never need an art-id row
# (`scripts/art/build-art-ids.ts --no-tokens`), so most of the padding here is
# tokens rather than new card names.
turn=8
activeplayer=human
activephase=MAIN1
humanlife=16
ailife=13
humanhand=
