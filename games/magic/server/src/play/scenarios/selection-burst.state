# selection-burst.jvm: alice (seat 0) casts Brainstorm off an untapped Island at her
# own Main Phase 1, draws Forest, Plains and Swamp, and is asked to put two back.
# Lightning Bolt in hand and an untapped Mountain make the priority window after it
# one where a click on Bolt casts it — what a click sent for the pick must never do.
turn=1
activeplayer=human
activephase=MAIN1
humanlife=20
ailife=20
humanhand=Brainstorm;Lightning Bolt
humanbattlefield=Island;Mountain
humanlibrary=Forest;Plains;Swamp;Mountain;Mountain;Mountain
humangraveyard=
aihand=
aibattlefield=
ailibrary=Mountain;Mountain;Mountain;Mountain;Mountain;Mountain
aigraveyard=
