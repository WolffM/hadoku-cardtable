# e2e/replay-cursor.spec.ts — each player drags a land from the middle of their hand onto their own
# battlefield, between the two lands already there (different lands: one name piles into one column), on their own turn: alice (human keys, seat 0) on
# turn 1, bob (ai keys, seat 1) on turn 2, and bob concedes. The front page's replay of it must start
# each player's cursor on the card they lifted and land each card in the column they put it in.
turn=1
activeplayer=human
activephase=MAIN1
humanlife=20
ailife=20
humanhand=Lightning Bolt;Mountain;Grizzly Bears
humanbattlefield=Plains;Forest
humanlibrary=Mountain;Mountain;Mountain;Mountain;Mountain;Mountain;Mountain;Mountain
humangraveyard=
aihand=Dark Ritual;Swamp;Memnite
aibattlefield=Island;Forest
ailibrary=Island;Island;Island;Island;Island;Island;Island;Island
aigraveyard=
