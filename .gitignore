# deps / build
node_modules/
dist/
*.tsbuildinfo
.venv/

# forge — currently a plain shallow clone of upstream, used for analysis.
# Untracked until WolffM/forge exists and this becomes a submodule.
# See README.md "Getting forge/".
# forge/ is a SUBMODULE as of 2026-09-16 (D2's stated mechanism), pinned to the
# fork WolffM/forge at 2cd497c — the commit every verified number in docs/ was
# measured against. It used to be listed here as a gitignored plain clone,
# because there was nothing to fork from until PR-4 needed to commit Java.
#
# Build output inside it is covered by Forge's OWN .gitignore, which is why
# `git status` there cannot see a stray Maven build — see
# scripts/spike/itoclient/run.sh's assert_forge_pristine.

# local state
.env
.env.*
*.log
logs/
data/
state/

# editor / OS
.DS_Store
.idea/
*.swp

# claude worktrees
.claude/worktrees/

# card images — never commit these (see docs/LICENSING.md)
cards/
card-images/
*.jpg
*.jpeg
*.png
# Evidence screenshots are not committed either (operator, 2026-10-03): the
# `!docs/**/*.png` exception that let 60 of them (9.6 MB) into history is gone.
# The 60 that were tracked were deleted on 2026-10-11; describe evidence in
# words, or keep the image outside git.

# sound-builder audio — never committed, never bundled (docs/planning/wave50-2026-10-06.md).
# Takes are server-hosted under CARDTABLE_SOUNDS_DIR, outside this tree entirely.
*.ogg
*.wav
*.mp3
*.flac
# The operator's drop folder for new audio (scripts/sfx/add-track.py reads it). Never committed.
ingest/

# wave handoffs (per-wave, not tracked)
docs/handoff/

# dev-vault caller key (raw service-tier key) — never commit
.devvault.local.json

# Python bytecode (scripts/sfx)
__pycache__/
