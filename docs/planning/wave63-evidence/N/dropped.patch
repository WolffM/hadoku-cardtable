+/*
+ * AE11, playtest 15: *"in the chat it says 'Eisen' but in the game it correctly
+ * sees the name as 'Bella' … there should only be one source of truth."* The
+ * board's half of that one source: `nameByPlayerId` (`forge:seats`, fed from
+ * `member.name` server-side) wins over Forge's own `PlayerView.Name` whenever
+ * it names the seat, the same way `avatarByPlayerId` already wins over the
+ * generated bust above. Nothing else on the board — the stack's target label
+ * included (`playerNameById` is built from these SAME resolved `players[].name`
+ * values, `adapter.ts`'s T8 comment) — reads a player's name any other way.
+ */
+describe('the seat’s name is the registry’s, not Forge’s own PlayerView.Name (AE11)', () => {
+  it('a seat named on the map draws THAT name instead of the wire’s own PlayerView.Name', () => {
+    const before = adapt(baseState()).players.find((p) => p.isViewer)!;
+    const view = toBoardView(baseState(), 27, {
+      viewerPlayerId: fixture.viewerPlayerId,
+      nameByPlayerId: new Map([[fixture.viewerPlayerId, 'Eisen']]),
+    });
+    const after = view.players.find((p) => p.isViewer)!;
+    expect(after.name).toBe('Eisen');
+    // The premise: this really did change something, not an id already named 'Eisen'.
+    expect(after.name).not.toBe(before.name);
+  });
+
+  it('a blank or whitespace-only name on the map is never drawn — wire data, never trusted blind', () => {
+    const before = adapt(baseState()).players.find((p) => p.isViewer)!;
+    for (const blank of ['', '   ']) {
+      const view = toBoardView(baseState(), 27, {
+        viewerPlayerId: fixture.viewerPlayerId,
+        nameByPlayerId: new Map([[fixture.viewerPlayerId, blank]]),
+      });
+      expect(view.players.find((p) => p.isViewer)!.name).toBe(before.name);
+    }
+  });
+
+  it('with no map at all, or a seat the map does not name, every committed fixture still draws exactly as before', () => {
+    const before = adapt(baseState()).players;
+    const view = toBoardView(baseState(), 27, { viewerPlayerId: fixture.viewerPlayerId, nameByPlayerId: new Map() });
+    for (const p of before) {
+      expect(view.players.find((v) => v.id === p.id)!.name).toBe(p.name);
+    }
+  });
+});
